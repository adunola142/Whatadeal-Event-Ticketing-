// Whatadeal Event Ticketing & POS Management Platform
// Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  EVENT_MANAGER
  POS_OPERATOR
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  REJECTED
  APPROVED
  PUBLISHED
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  EXPIRED
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String    @map("password_hash")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String?
  role           UserRole  @default(POS_OPERATOR)
  isActive       Boolean   @default(true) @map("is_active")
  emailVerified  Boolean   @default(false) @map("email_verified")
  lastLoginAt    DateTime? @map("last_login_at")
  refreshToken   String?   @map("refresh_token")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  organizationMemberships OrganizationMember[]
  posOperator             POSOperator?
  approvedEvents          Event[]              @relation("EventApprover")
  auditLogs               AuditLog[]
  createdByOrgs           Organization[]       @relation("OrgCreator")

  @@map("users")
}

// ============================================
// ORGANIZATIONS
// ============================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy  User                 @relation("OrgCreator", fields: [createdById], references: [id])
  members    OrganizationMember[]
  events     Event[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           UserRole @default(EVENT_MANAGER)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@map("organization_members")
}

// ============================================
// EVENTS
// ============================================

model Event {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id")
  title           String
  slug            String      @unique
  description     String?
  venue           String
  address         String?
  city            String?
  state           String?
  country         String?     @default("Nigeria")
  startDate       DateTime    @map("start_date")
  endDate         DateTime    @map("end_date")
  status          EventStatus @default(DRAFT)
  bannerImage     String?     @map("banner_image")
  maxCapacity     Int?        @map("max_capacity")
  isPublic        Boolean     @default(true) @map("is_public")

  // Approval workflow fields
  submittedAt     DateTime?   @map("submitted_at")
  approvedById    String?     @map("approved_by_id")
  approvedAt      DateTime?   @map("approved_at")
  rejectionReason String?     @map("rejection_reason")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id])
  approvedBy       User?             @relation("EventApprover", fields: [approvedById], references: [id])
  ticketCategories TicketCategory[]
  eventAssignments EventAssignment[]
  transactions     Transaction[]

  @@index([organizationId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("events")
}

// ============================================
// TICKET CATEGORIES
// ============================================

model TicketCategory {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  name           String
  description    String?
  price          Decimal  @db.Decimal(12, 2)
  totalQuantity  Int      @map("total_quantity")
  soldQuantity   Int      @default(0) @map("sold_quantity")
  reservedQuantity Int    @default(0) @map("reserved_quantity")
  maxPerTransaction Int   @default(10) @map("max_per_transaction")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  salesStartDate DateTime? @map("sales_start_date")
  salesEndDate   DateTime? @map("sales_end_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  event            Event             @relation(fields: [eventId], references: [id])
  transactionItems TransactionItem[]
  tickets          Ticket[]

  @@index([eventId])
  @@map("ticket_categories")
}

// ============================================
// POS - Operators, Devices, Assignments
// ============================================

// POS Operators are managed by Whatadeal (super admin), NOT by organizations
model POSOperator {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  employeeId  String?  @unique @map("employee_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations — NO organizationId (Whatadeal-managed)
  user              User                @relation(fields: [userId], references: [id])
  eventAssignments  EventAssignment[]
  deviceAssignments POSDeviceAssignment[]
  transactions      Transaction[]

  @@map("pos_operators")
}

model POSDevice {
  id           String       @id @default(uuid())
  serialNumber String       @unique @map("serial_number")
  model        String?
  status       DeviceStatus @default(ACTIVE)
  lastActiveAt DateTime?    @map("last_active_at")
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  deviceAssignments POSDeviceAssignment[]

  @@map("pos_devices")
}

model EventAssignment {
  id            String    @id @default(uuid())
  operatorId    String    @map("operator_id")
  eventId       String    @map("event_id")
  assignedAt    DateTime  @default(now()) @map("assigned_at")
  unassignedAt  DateTime? @map("unassigned_at")
  isActive      Boolean   @default(true) @map("is_active")

  // Relations
  operator POSOperator @relation(fields: [operatorId], references: [id])
  event    Event       @relation(fields: [eventId], references: [id])

  @@index([operatorId])
  @@index([eventId])
  @@map("event_assignments")
}

model POSDeviceAssignment {
  id           String    @id @default(uuid())
  operatorId   String    @map("operator_id")
  deviceId     String    @map("device_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  isActive     Boolean   @default(true) @map("is_active")

  // Relations
  operator POSOperator @relation(fields: [operatorId], references: [id])
  device   POSDevice   @relation(fields: [deviceId], references: [id])

  @@index([operatorId])
  @@index([deviceId])
  @@map("pos_device_assignments")
}

// ============================================
// TRANSACTIONS & TICKETS
// ============================================

model Transaction {
  id                String            @id @default(uuid())
  transactionRef    String            @unique @map("transaction_ref")
  eventId           String            @map("event_id")
  operatorId        String            @map("operator_id")
  totalAmount       Decimal           @map("total_amount") @db.Decimal(12, 2)
  paymentMethod     PaymentMethod     @map("payment_method")
  status            TransactionStatus @default(PENDING)
  customerName      String?           @map("customer_name")
  customerEmail     String?           @map("customer_email")
  customerPhone     String?           @map("customer_phone")
  deviceId          String?           @map("device_id")
  paymentReference  String?           @map("payment_reference")
  metadata          Json?
  completedAt       DateTime?         @map("completed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // Relations
  event    Event             @relation(fields: [eventId], references: [id])
  operator POSOperator       @relation(fields: [operatorId], references: [id])
  items    TransactionItem[]
  tickets  Ticket[]
  receipt  Receipt?
  refunds  Refund[]
  paymentLogs PaymentLog[]

  @@index([eventId])
  @@index([operatorId])
  @@index([transactionRef])
  @@index([createdAt])
  @@map("transactions")
}

model TransactionItem {
  id               String  @id @default(uuid())
  transactionId    String  @map("transaction_id")
  ticketCategoryId String  @map("ticket_category_id")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)

  // Relations
  transaction    Transaction    @relation(fields: [transactionId], references: [id])
  ticketCategory TicketCategory @relation(fields: [ticketCategoryId], references: [id])

  @@map("transaction_items")
}

model Ticket {
  id               String       @id @default(uuid())
  ticketNumber     String       @unique @map("ticket_number")
  transactionId    String       @map("transaction_id")
  ticketCategoryId String       @map("ticket_category_id")
  status           TicketStatus @default(VALID)
  qrCode           String?      @map("qr_code")
  usedAt           DateTime?    @map("used_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relations
  transaction    Transaction    @relation(fields: [transactionId], references: [id])
  ticketCategory TicketCategory @relation(fields: [ticketCategoryId], references: [id])

  @@index([ticketNumber])
  @@index([transactionId])
  @@map("tickets")
}

// ============================================
// RECEIPTS
// ============================================

model Receipt {
  id            String   @id @default(uuid())
  transactionId String   @unique @map("transaction_id")
  receiptNumber String   @unique @map("receipt_number")
  content       Json
  printedAt     DateTime? @map("printed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("receipts")
}

// ============================================
// REFUNDS
// ============================================

model Refund {
  id            String       @id @default(uuid())
  transactionId String       @map("transaction_id")
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  status        RefundStatus @default(PENDING)
  approvedById  String?      @map("approved_by_id")
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@map("refunds")
}

// ============================================
// PAYMENT LOGS
// ============================================

model PaymentLog {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  provider      String
  action        String
  request       Json?
  response      Json?
  statusCode    Int?     @map("status_code")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@map("payment_logs")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// SETTLEMENTS
// ============================================

model Settlement {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  eventId          String?          @map("event_id")
  totalAmount      Decimal          @map("total_amount") @db.Decimal(12, 2)
  platformFee      Decimal          @map("platform_fee") @db.Decimal(12, 2)
  netAmount        Decimal          @map("net_amount") @db.Decimal(12, 2)
  status           SettlementStatus @default(PENDING)
  settlementRef    String?          @unique @map("settlement_ref")
  processedAt      DateTime?        @map("processed_at")
  periodStart      DateTime         @map("period_start")
  periodEnd        DateTime         @map("period_end")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([status])
  @@map("settlements")
}
