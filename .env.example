# Database (Neon PostgreSQL)
# Pooled connection string — used by the app at runtime
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (unpooled) connection string — used by Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# JWT
JWT_SECRET="change-this-to-a-secure-secret-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production"
JWT_REFRESH_EXPIRATION="7d"

# App
PORT=3000
NODE_ENV=development
